[Unit]
Description=Tradelab daglig rebalancering (LIVE - kræver godkendelse)
After=network-online.target ibgateway-live.service

[Service]
Type=oneshot
User=trader
WorkingDirectory=/home/trader/putcall
EnvironmentFile=/home/trader/putcall/.env.live
ExecStart=/home/trader/putcall/.venv/bin/python -m tradelab trade --mode live
TimeoutStartSec=30min
