[Unit]
Description=Start XSP-botten 09:15 New York-tid, mandag-fredag

[Timer]
# Tidszonen står i selve kalenderudtrykket, så VPS'ens egen tidszone er ligegyldig
OnCalendar=Mon..Fri *-*-* 09:15:00 America/New_York
Persistent=false
AccuracySec=1s
Unit=xspbot.service

[Install]
WantedBy=timers.target
